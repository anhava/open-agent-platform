{
  "name": "aihio",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "analyze": "ANALYZE=true pnpm run build",
    "build": "next build",
    "build:test": "NODE_ENV=test next build --turbopack",
    "clean": "git clean -xdf .next .turbo node_modules",
    "dev": "next dev --turbo | pino-pretty -c",
    "lint": "eslint .",
    "lint:fix": "next lint --fix",
    "format": "prettier --check \"**/*.{js,cjs,mjs,ts,tsx,md,json}\"",
    "start": "next start",
    "start:test": "NODE_ENV=test next start",
    "typecheck": "tsc --noEmit",
    "supabase": "supabase",
    "supabase:start": "supabase status || supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:status": "supabase status",
    "supabase:test": "supabase db test",
    "supabase:db:lint": "supabase db lint",
    "supabase:db:diff": "supabase db diff",
    "supabase:deploy": "supabase link --project-ref $SUPABASE_PROJECT_REF && supabase db push",
    "supabase:typegen": "pnpm run supabase:typegen:packages && pnpm run supabase:typegen:app",
    "supabase:typegen:packages": "supabase gen types typescript --local > ../../packages/supabase/src/database.types.ts",
    "supabase:typegen:app": "supabase gen types typescript --local > ./lib/database.types.ts",
    "supabase:db:dump:local": "supabase db dump --local --data-only"
  },
  "dependencies": {
    "@aihio/accounts": "workspace:*",
    "@aihio/admin": "workspace:*",
    "@aihio/analytics": "workspace:*",
    "@aihio/auth": "workspace:*",
    "@aihio/billing": "workspace:*",
    "@aihio/billing-gateway": "workspace:*",
    "@aihio/cms": "workspace:*",
    "@aihio/database-webhooks": "workspace:*",
    "@aihio/email-templates": "workspace:*",
    "@aihio/i18n": "workspace:*",
    "@aihio/mailers": "workspace:*",
    "@aihio/monitoring": "workspace:*",
    "@aihio/next": "workspace:*",
    "@aihio/notifications": "workspace:*",
    "@aihio/shared": "workspace:*",
    "@aihio/supabase": "workspace:*",
    "@aihio/team-accounts": "workspace:*",
    "@aihio/ui": "workspace:*",
    "@edge-csrf/nextjs": "2.5.3-cloudflare-rc1",
    "@hookform/resolvers": "^5.0.1",
    "@marsidev/react-turnstile": "^1.1.0",
    "@nosecone/next": "1.0.0-beta.6",
    "@radix-ui/react-icons": "^1.3.2",
    "@supabase/supabase-js": "2.49.4",
    "@tanstack/react-query": "5.72.2",
    "@tanstack/react-table": "^8.21.2",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.487.0",
    "next": "15.3.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.55.0",
    "react-i18next": "^15.4.1",
    "recharts": "2.15.3",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@aihio/eslint-config": "workspace:*",
    "@aihio/prettier-config": "workspace:*",
    "@aihio/tsconfig": "workspace:*",
    "@next/bundle-analyzer": "15.3.1",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.14.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.2",
    "babel-plugin-react-compiler": "19.1.0-rc.1",
    "cssnano": "^7.0.6",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "supabase": "^2.22.6",
    "tailwindcss": "4.1.4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3"
  },
  "prettier": "@aihio/prettier-config",
  "browserslist": [
    "last 1 versions",
    "> 0.7%",
    "not dead"
  ]
}
